{
  "$schema": "https://biomejs.dev/schemas/2.4.2/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**",
      "!node_modules",
      "!.next",
      "!dist",
      "!build",
      "!coverage"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true
    },
    "domains": {
      "next": "recommended",
      "react": "recommended"
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "overrides": [
    {
      "includes": ["src/features/auth/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "@/features/tournament/**",
                      "../tournament/**",
                      "@/components/**",
                      "../../components/**",
                      "@/app/**",
                      "../../app/**"
                    ],
                    "message": "features/auth は他の機能・UI・app に依存できません。共通処理は src/shared に置いてください。"
                  },
                  {
                    "group": [
                      "@/features/auth/login/**",
                      "./login/**",
                      "@/features/auth/signup/**",
                      "./signup/**"
                    ],
                    "message": "features/auth 直下から下位スライス（login・signup）に依存することはできません。祖先方向の参照のみ許可されます。共有するものは features/auth 直下か src/shared へ置いてください。"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/features/auth/login/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "@/features/tournament/**",
                      "../../tournament/**",
                      "@/components/**",
                      "../../../components/**",
                      "@/app/**",
                      "../../../app/**"
                    ],
                    "message": "features/auth は他の機能・UI・app に依存できません。共通処理は src/shared に置いてください。"
                  },
                  {
                    "group": [
                      "@/features/auth/signup/**",
                      "@/features/auth/logout/**",
                      "../signup/**",
                      "../logout/**"
                    ],
                    "message": "同列のスライスには依存できません。共有するものは features/auth 直下か src/shared へ。"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/features/auth/signup/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "@/features/tournament/**",
                      "../../tournament/**",
                      "@/components/**",
                      "../../../components/**",
                      "@/app/**",
                      "../../../app/**"
                    ],
                    "message": "features/auth は他の機能・UI・app に依存できません。共通処理は src/shared に置いてください。"
                  },
                  {
                    "group": [
                      "@/features/auth/login/**",
                      "@/features/auth/logout/**",
                      "../login/**",
                      "../logout/**"
                    ],
                    "message": "同列のスライスには依存できません。共有するものは features/auth 直下か src/shared へ。"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/features/tournament/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "@/features/auth/**",
                      "../auth/**",
                      "../../auth/**",
                      "@/components/**",
                      "../../components/**",
                      "../../../components/**",
                      "@/app/**",
                      "../../app/**",
                      "../../../app/**"
                    ],
                    "message": "features/tournament は他の機能・UI・app に依存できません。"
                  },
                  {
                    "group": ["@/features/tournament/mock/**", "./mock/**"],
                    "message": "features/tournament 直下から下位スライス（mock）に依存することはできません。祖先方向の参照のみ許可されます。"
                  }
                ]
              }
            }
          }
        }
      }
    }
  ]
}
