# PostgreSQL connection string used by Prisma (prisma7.config.ts / src/lib/prisma.ts)
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/tournament?schema=public"

# Better Auth
# BETTER_AUTH_SECRET は `openssl rand -base64 32` などで生成する
BETTER_AUTH_SECRET="replace-with-a-random-32-byte-string"
# BETTER_AUTH_URL は実際にアプリを配信しているオリジンと一致させること。
# 3000番ポートが使用中で next dev が別ポートにフォールバックした場合も、
# 実際に開いているポートに合わせて変更する必要がある。
# ずれていると、Cookie を伴わない curl 等の疎通確認は通ってしまう一方、
# ログイン後のブラウザからのリクエスト（ログアウトなど）だけが
# 403 INVALID_ORIGIN で失敗するため気づきにくい。
BETTER_AUTH_URL="http://localhost:3000"

# Google OAuth（Google Cloud Console で発行する。手順は README を参照）
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
